# Copy to .env (local) or add in Render > Environment. NEVER upload real .env to GitHub.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/growcend_db?retryWrites=true&w=majority
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS
ADMIN_USERNAME=director
ADMIN_PASSWORD=ChangeThis@123
ADMIN_NAME=Director Growcend

# OPTIONAL: second free MongoDB cluster only for document images (doubles free space)
# FILES_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster2.xxxxx.mongodb.net/growcend_files?retryWrites=true&w=majority
