# Copy this file to .env and fill real values. NEVER share .env or upload it to GitHub.
NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/growcend_db?retryWrites=true&w=majority

# Long random secret (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# First Super Admin — created automatically on first start if database has no users
ADMIN_USERNAME=director
ADMIN_PASSWORD=ChangeThis@123
ADMIN_NAME=Director Growcend

# Only needed if frontend is hosted on a different domain than the API
# CORS_ORIGIN=https://crm.yourdomain.com
